# Copy to deploy/production.env and fill in. That file is git-ignored. Never commit real values.
AGENTSHIELD_TENANTS=/etc/agentshield/tenants.json
AGENTSHIELD_MODEL_DIR=models/portable_v1
AGENTSHIELD_AUDIT=/audit/audit.jsonl
AGENTSHIELD_AUDIT_SALT=change-me-to-a-long-random-string
# Agent trust: fetch agent keys from the directory named in each request, and keep replay protection in Redis.
AGENTSHIELD_AGENT_DIRECTORY=1
AGENTSHIELD_REDIS_URL=redis://redis:6379/0
